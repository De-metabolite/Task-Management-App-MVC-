@model IEnumerable<TaskItem>
<p><a  asp-controller= "Task" asp-action="Create" class="btn btn-primary">Create a new task</a></p>
<table class="table">
    <thead>
        <tr>
            <th scope="col">Task Id</th>
            <th scope="col">Title</th>
            <th scope="col">Description</th>
            <th scope="col">DueDate</th>
            <th scope="col">Priority</th>
            <th scope="col">Status</th>
            <th scope="col">CreatedAt</th>
            
        </tr>
    </thead>
    <tbody>
        @foreach( var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(t=>item.Id)</td>
                <td>@Html.DisplayFor(t => item.Title)</td>
                <td>@Html.DisplayFor(t => item.Description)</td>
                <td>@Html.DisplayFor(t => item.DueDate)</td>
                <td>@Html.DisplayFor(t => item.Priority)</td>
                <td>@Html.DisplayFor(t => item.Status)</td>
                <td>@Html.DisplayFor(t => item.CreatedAt)</td>
                <td><a asp-controller="Task" asp-action="Edit" asp-route-id="@item.Id"
                    class="btn btn-primary">Edit</a></td>
                <td><form asp-controller="Task" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this task?')">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
                </td>
            </tr>
        }
    </tbody>
</table>
